# Firebase Web Configuration Template
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# ==============================================================================
# Razorpay Payment Gateway (India INR)
# ==============================================================================
# Key ID is returned to Checkout by the server after an order is created.
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID

# Private Server Secret (NEVER prefix with VITE_, keep safe in Vercel secrets)
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# Webhook Secret (from Razorpay Dashboard > Settings > Webhooks)
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# Prices are configured in shared/product.js, not environment variables.

# ==============================================================================
# Cloudflare R2 Object Storage (Private Course Storage)
# ==============================================================================
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=menticocourse001
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
R2_REGION=auto


# Optional dedicated secret for signed guest passes (server only; no public prefix)
# ACCESS_TOKEN_SECRET=generate-a-long-random-secret

# Purchase confirmation & recovery emails (server only; sender domain must be verified in Resend)
RESEND_API_KEY=your_resend_sending_api_key
CONFIRMATION_FROM_EMAIL=Mentico <orders@mentico.co.in>
RECOVERY_FROM_EMAIL=Mentico <access@mentico.co.in>
