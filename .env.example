# Firebase Web Configuration Template
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# ==============================================================================
# Razorpay Payment Gateway (India INR)
# ==============================================================================
# Key ID is returned to Checkout by the server after an order is created.
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID

# Private Server Secret (NEVER prefix with VITE_, keep safe in Vercel secrets)
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# Webhook Secret (from Razorpay Dashboard > Settings > Webhooks)
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# Keep the display price and authoritative server price in sync (Default 1 for testing).
VITE_PRODUCT_PRICE_INR=1
PRODUCT_PRICE_INR=1

# Firebase Admin credentials for payment fulfillment (server only)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nYOUR_KEY\\n-----END PRIVATE KEY-----\\n"
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# ==============================================================================
# Cloudflare R2 Object Storage (Private PDF Document Vault)
# ==============================================================================
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=mentico-pdf
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
R2_REGION=auto

