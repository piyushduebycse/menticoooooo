# Firebase Web Configuration Template
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# ==============================================================================
# Razorpay Payment Gateway (India INR)
# ==============================================================================
# Public Key ID (Client-safe, prefix with VITE_ for Vite, starts with rzp_test_ or rzp_live_)
VITE_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID

# Private Server Secret (NEVER prefix with VITE_, keep safe in Vercel secrets)
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# Webhook Secret (from Razorpay Dashboard > Settings > Webhooks)
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# Configurable INR Price (Default 499)
VITE_PRODUCT_PRICE_INR=499
