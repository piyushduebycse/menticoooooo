rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'createdAt', 'hasPurchased', 'hasPurchasedPdf', 'role'
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'Mentico Student'
        && request.resource.data.hasPurchased == false
        && request.resource.data.hasPurchasedPdf == false
        && !request.resource.data.keys().hasAny(['licenseKey', 'purchasedAt']);
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'updatedAt']);
      allow delete: if false;
    }

    match /purchases/{orderId} {
      allow read, write: if false;
    }

    match /support_tickets/{ticketId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
